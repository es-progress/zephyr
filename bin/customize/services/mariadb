#!/usr/bin/env bash
#############
## Zephyr  ##
##         ##
## Config  ##
## MariaDB ##
#############

###############
## FUNCTIONS ##
###############

## Copy MariaDB config file
##
## @param   $1  Global/Local
## @param   $2  Config dir
############################
_config() {
    local selector="${1:?Selector missing}"
    local cfg_dir="${2:?Config dir missing}"

    print-status Config MariaDB "[${selector}]..."
    find -L "${cfg_dir}" -mindepth 1 -maxdepth 1 -type f -exec sudo install --mode=0644 {} /etc/mysql/conf.d/ \;
    print-finish
}

##################
## SCRIPT START ##
##################

# Strict mode
set -eufo pipefail
IFS=$'\n\t'

source "${PROJECT_ROOT}/bin/bootstrap.sh"
check-not-root

# Options
profile="${1:?Profile missing}"
repo=
admin_name=
admin_pass=

# Read config file, get options
# shellcheck disable=SC2310,SC2311
if file=$(cfg-get "${profile}" services/global.cfg); then
    cfg-eval "${file}" mariadb
fi
# shellcheck disable=SC2310,SC2311
if file=$(cfg-get "${profile}" services/local.cfg); then
    cfg-eval "${file}" mariadb
fi
[[ -z "${repo}" ]] && error-exit Missing repo
[[ -z "${admin_name}" ]] && error-exit Missing admin_name
[[ -z "${admin_pass}" ]] && error-exit Missing admin_pass
if grep -qs signed-by= <<<"${repo}"; then
    gpg_key_path=$(sed -r 's@.*\[(.*)\].*@\1@' <<<"${repo}" | sed -r 's@.*signed-by=(\S+).*$@\1@')
else
    print-warning "DEPRECATED! Using a repo without the signed-by option is deprecated, see apt-key(8) for details."
    gpg_key_path=
fi

print-header Add MariaDB GPG key...
if [[ -n "${gpg_key_path}" ]]; then
    gpg_key_url=https://mariadb.org/mariadb_release_signing_key.pgp
    gpg_key_fingerprint=177F4010FE56CA3336300305F1656F24C74CD1D8

    if sudo test -r "${gpg_key_path}"; then
        fpr=$(gpg --show-keys --with-colons "${gpg_key_path}" | sed -n '/^pub:/,+1 p' | grep '^fpr' | cut -d: -f10 || true)
    else
        fpr=
    fi
    if [[ "${fpr}" == "${gpg_key_fingerprint}" ]]; then
        print-finish Already installed, skip.
    else
        tmp_file=$(mktemp)
        curl --disable --progress-bar -o "${tmp_file}" --url "${gpg_key_url}"
        fpr=$(gpg --show-keys --with-colons "${tmp_file}" | sed -n '/^pub:/,+1 p' | grep '^fpr' | cut -d: -f10 || true)
        [[ "${fpr}" != "${gpg_key_fingerprint}" ]] && error-exit Bad GPG key fingerprint, exiting
        sudo install --mode=0644 --no-target-directory "${tmp_file}" "${gpg_key_path}"
        rm -f "${tmp_file}"
        print-finish
    fi
else
    sudo apt-key adv --recv-keys --keyserver hkp://keyserver.ubuntu.com:80 0xF1656F24C74CD1D8
    print-finish
fi

print-header Add MariaDB APT repo...
if [[ -n "${gpg_key_path}" ]]; then
    # We need to manually write sources, as add-apt-repository does not support the signed-by option
    echo "${repo}" | sudo tee /etc/apt/sources.list.d/mariadb.list > /dev/null
    sudo apt-get update
else
    sudo add-apt-repository --yes "${repo}"
fi
print-finish

install-apt mariadb-server mariadb-backup python3-pymysql

print-status Load timezone data...
mariadb-tzinfo-to-sql /usr/share/zoneinfo | sudo mysql -D mysql
print-finish

# shellcheck disable=SC2310,SC2311
if dir=$(cfg-get "${profile}" services/mariadb/global.d); then
    _config global "${dir}"
fi
# shellcheck disable=SC2310,SC2311
if dir=$(cfg-get "${profile}" services/mariadb/local.d); then
    _config local "${dir}"
fi

print-header Restart services...
sudo systemctl enable mariadb.service
sudo systemctl restart mariadb.service
print-finish

print-status Create DB admin...
sudo mysql -e "CREATE USER IF NOT EXISTS '${admin_name}'@'localhost' IDENTIFIED BY '${admin_pass}';"
sudo mysql -e "GRANT ALL ON *.* TO '${admin_name}'@localhost WITH GRANT OPTION;"
sudo mysql -e "FLUSH PRIVILEGES;"
print-finish

exit 0
