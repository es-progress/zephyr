#!/usr/bin/env bash
################
## Zephyr     ##
##            ##
## Config     ##
## Github CLI ##
################

# Strict mode
set -eufo pipefail
IFS=$'\n\t'

source "${PROJECT_ROOT}/bin/bootstrap.sh"
check-not-root

# Options
profile="${1:?Profile missing}"
url=
checksum=

# Read config file, get options
# shellcheck disable=SC2310,SC2311
if file=$(cfg-get "${profile}" tools/global.cfg); then
    cfg-eval "${file}" gh
fi
# shellcheck disable=SC2310,SC2311
if file=$(cfg-get "${profile}" tools/local.cfg); then
    cfg-eval "${file}" gh
fi
[[ -z "${url}" ]] && error-exit Missing url
[[ -z "${checksum}" ]] && error-exit Missing checksum

install-apt curl git

print-header Install github-cli...
marker_dir=/usr/local/lib/zephyr
marker_file="${marker_dir}/gh.sha256"
if command -v gh >/dev/null 2>&1 && sudo test -r "${marker_file}" && sudo grep -qsx "${checksum}" "${marker_file}"; then
    print-finish Already installed, skip.
    exit 0
fi
# Download deb
tmp_file=$(mktemp)
curl --disable --progress-bar --location -o "${tmp_file}" --url "${url}"
if ! echo "${checksum}  ${tmp_file}" | sha256sum --check --status --strict -; then
    error-exit Bad checksum, exiting
fi
# Install
sudo dpkg -i "${tmp_file}"
sudo install -d --mode=0755 "${marker_dir}"
echo "${checksum}" | sudo tee "${marker_file}" >/dev/null
rm -f "${tmp_file}"
# Bash completion
gh completion -s bash | sudo tee /usr/share/bash-completion/completions/gh >/dev/null
print-finish

exit 0
