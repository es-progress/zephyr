#!/usr/bin/env bash
#################
## Zephyr      ##
##             ##
## Config      ##
## pass-update ##
#################

# Strict mode
set -eufo pipefail
IFS=$'\n\t'

source "${PROJECT_ROOT}/bin/bootstrap.sh"
check-not-root

# Options
profile="${1:?Profile missing}"
version=

# Read config file, get options
# shellcheck disable=SC2310,SC2311
if file=$(cfg-get "${profile}" tools/global.cfg); then
    cfg-eval "${file}" pass-update
fi
# shellcheck disable=SC2310,SC2311
if file=$(cfg-get "${profile}" tools/local.cfg); then
    cfg-eval "${file}" pass-update
fi
[[ -z "${version}" ]] && error-exit Missing version

install-apt git make

print-header Install pass-update...
marker_dir=/usr/local/lib/zephyr
marker_file="${marker_dir}/pass-update.version"
if command -v pass-update >/dev/null 2>&1 && sudo test -r "${marker_file}" && sudo grep -qsx "${version}" "${marker_file}"; then
    print-finish Already installed, skip.
else
    tmp_dir=$(mktemp -d)
    git clone --depth 1 --branch "${version}" https://github.com/roddhjav/pass-update.git "${tmp_dir}"
    sudo make -C "${tmp_dir}" install
    sudo install -d --mode=0755 "${marker_dir}"
    echo "${version}" | sudo tee "${marker_file}" >/dev/null
    rm -rf "${tmp_dir}"
    print-finish
fi

exit 0
